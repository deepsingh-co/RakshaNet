# Copy to .env for local development.
# The Expo CLI inlines EXPO_PUBLIC_* values at build time.

# Web / iOS simulator / Android emulator on the same machine:
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Physical phone (Expo Go): use your computer's LAN IP instead, for example
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
# Android emulator special-cases localhost as http://10.0.2.2:4000/api/v1
