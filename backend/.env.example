# ---- SURAKSHA AI backend ----
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/suraksha_ai

# JWT (generate strong random strings in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Gnani AI (server-side only — never expose to clients)
GNANI_API_KEY=
GNANI_API_URL=
GNANI_LANGUAGE=auto
AI_PROVIDER=gnani

# Notification providers (leave blank to run in "recorded, not sent" mode)
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
PUSH_PROVIDER=
PUSH_API_KEY=

# OTP behaviour: console = log code server-side (dev only)
OTP_MODE=console
