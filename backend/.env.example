# ---- SURAKSHA AI backend ----
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/suraksha_ai

# JWT (generate strong random strings in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# Gnani AI — Prisma v3.0 Speech-to-Text (server-side only; never expose to clients)
#
# Verified contract: POST https://api.vachana.ai/stt/v3 (multipart/form-data)
# Auth header: X-API-Key-ID. Get a key from https://app.gnani.ai/voice/.
# AI_MODE=live enables real transcription. If GNANI_API_KEY is missing the
# backend refuses to start in live mode instead of silently faking a result.
# AI_MODE=console keeps transcription disabled and only runs the local,
# deterministic intent classifier. Text intent is always local — Gnani exposes
# no text-intent/chat endpoint.
GNANI_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
# indic-auto detects the spoken language; or hi-IN, en-IN, mr-IN (max 4).
GNANI_STT_LANGUAGE=indic-auto
# verbatim | transcribe | codemix | transliterate
GNANI_STT_FORMAT=codemix
GNANI_TIMEOUT_MS=20000
AI_PROVIDER=gnani
AI_MODE=console

# Notification providers.
# NOTIFICATION_MODE=console logs and records simulated sends (dev only).
# NOTIFICATION_MODE=live calls the HTTP gateways below; unconfigured channels
# fail honestly as PROVIDER_NOT_CONFIGURED instead of pretending to send.
NOTIFICATION_MODE=console
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_URL=
SMS_FROM=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
PUSH_PROVIDER=
PUSH_API_KEY=
PUSH_API_URL=

# Provider webhook verification (HMAC-SHA256 of the raw body)
NOTIFICATION_WEBHOOK_SECRET=

# Escalation + stale-location thresholds (seconds)
ESCALATION_AFTER_SECONDS=120
LOCATION_STALE_AFTER_SECONDS=120

# OTP behaviour: console = log code server-side (dev only)
OTP_MODE=console
