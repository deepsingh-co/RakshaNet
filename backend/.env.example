# ---- SURAKSHA AI backend ----
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/suraksha_ai

# JWT (generate strong random strings in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# Gnani AI (server-side only — never expose to clients)
# AI_MODE=console uses a deterministic local classifier and labels results
# simulated. AI_MODE=live calls GNANI_API_URL; if credentials are missing or
# the provider fails, the API falls back and returns degraded=true.
GNANI_API_KEY=
GNANI_API_URL=
GNANI_LANGUAGE=auto
GNANI_TIMEOUT_MS=8000
AI_PROVIDER=gnani
AI_MODE=console

# Notification providers.
# NOTIFICATION_MODE=console logs and records simulated sends (dev only).
# NOTIFICATION_MODE=live calls the HTTP gateways below; unconfigured channels
# fail honestly as PROVIDER_NOT_CONFIGURED instead of pretending to send.
NOTIFICATION_MODE=console
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_URL=
SMS_FROM=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
PUSH_PROVIDER=
PUSH_API_KEY=
PUSH_API_URL=

# Provider webhook verification (HMAC-SHA256 of the raw body)
NOTIFICATION_WEBHOOK_SECRET=

# Escalation + stale-location thresholds (seconds)
ESCALATION_AFTER_SECONDS=120
LOCATION_STALE_AFTER_SECONDS=120

# OTP behaviour: console = log code server-side (dev only)
OTP_MODE=console
